# ── Supabase (obligatorias) ──────────────────────────────────────────────────
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_JWT_SECRET=<32-chars-min-secret-from-supabase-dashboard>

# ── CORS (obligatoria) ───────────────────────────────────────────────────────
# CSV de orígenes permitidos
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── App (opcionales con default) ─────────────────────────────────────────────
LOG_LEVEL=INFO
API_PREFIX=/api/v1

# Parámetros de validación geo-temporal (overrides de la RPC)
VALIDACION_RADIO_METROS=100
VALIDACION_VENTANA_MINUTOS=10
VALIDACION_UMBRAL_DB=65

# Heatmap
HEATMAP_GRID_SIZE_DEG=0.001
HEATMAP_MAX_WINDOW_DAYS=7

# Storage: archivos generados desde el panel admin (PDF/CSV/imagen)
STORAGE_BUCKET_REPORTES_ADMIN=reportes-admin
STORAGE_SIGNED_URL_TTL_SECONDS=300
ARCHIVO_MAX_SIZE_MB=20

# ── MQTT (opcionales — si faltan, el ingestor no arranca pero HTTP sí) ────────
MQTT_BROKER_URL=ssl://<cluster>.s1.eu.hivemq.cloud:8883
MQTT_USER=backend-subscriber
MQTT_PASSWORD=<secret>
MQTT_CLIENT_ID=40db-backend-dev
